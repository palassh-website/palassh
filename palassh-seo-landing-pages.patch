+          </ul>
+          <p className="text-sm text-stone-600">
+            Questions before you order?{" "}
+            <a
+              href={getWhatsAppUrl(whatsappMessage)}
+              className="font-semibold text-[#C84617] hover:underline"
+              rel="noopener"
