generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Customer {
  id            String         @id @default(cuid())
  email         String         @unique
  phone         String         @unique
  fullName      String         @default("PALASSH Devotee")
  flatWing      String         @default("")
  societyName   String         @default("")
  pincode       String         @default("400605")
  deliveryNote  String         @default("Hang pouch on main door handle (Do not ring bell)")
  activeTier    String         @default("NORMAL") // NORMAL | ONE_DAY | WEEKLY | MONTHLY
  isVerified    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  subscriptions Subscription[]
  oneTimeOrders OneTimeOrder[]
  payments      Payment[]
}

model OtpVerification {
  id        String   @id @default(cuid())
  email     String
  phone     String   @default("")
  code      String
  purpose   String   @default("CHECKOUT_VERIFY")
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, code])
}

model Payment {
  id                      String    @id @default(cuid())
  razorpayOrderId         String    @unique
  razorpayPaymentId       String?   @unique
  razorpaySignature       String?   @db.VarChar(255)
  customerId              String
  customer                Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderType               String    // SUBSCRIPTION | ONE_TIME
  status                  String    @default("CREATED") // CREATED | PAID | FAILED
  amountInRupees          Int
  amountInPaise           Int
  currency                String    @default("INR")

  // Server-locked order snapshot (Client cannot tamper with these during verify)
  pincode                 String
  deliveryDate            String
  fullNameSnapshot        String    @default("")
  flatWingSnapshot        String    @default("")
  societyNameSnapshot     String    @default("")
  addressSnapshot         String    @db.Text
  deliveryNoteSnapshot    String    @db.Text

  // Subscription snapshot fields
  planId                  String?
  planSlug                String?
  planTitle               String?
  billingCycle            String?
  deliveriesCount         Int?
  weightGrams             Int?
  productVariantId        String?
  defaultFlowersSnapshot  String?   @db.Text

  // One-Time Add-On snapshot fields
  cartItemsJson           String?   @db.Text
  flowerSummarySnapshot   String?   @db.Text
  totalGramsSnapshot      Int?

  // Resulting created order reference for idempotent replay responses
  createdPublicOrderId    String?   @unique
  paidAt                  DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([customerId, status])
}

model Subscription {
  id                  String                  @id @default(cuid())
  orderId             String                  @unique
  customerId          String
  customer            Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  planId              String
  planTitle           String
  billingCycle        String
  pricePaid           Int
  totalDeliveries     Int
  remainingDeliveries Int
  maxPausesAllowed    Int                     @default(0)
  pausesUsedCount     Int                     @default(0)
  status              String                  @default("ACTIVE")
  startDate           String
  deliverySlot        String                  @default("6:00 AM – 8:00 AM")
  defaultFlowers      String                  @db.Text
  addressSnapshot     String                  @db.Text
  deliveryNote        String                  @db.Text
  razorpayOrderId     String?                 @unique
  razorpayPaymentId   String?                 @unique
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  scheduleDays        DailyDeliverySchedule[]

  @@index([customerId, status])
}

model DailyDeliverySchedule {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  dayNumber      Int
  deliveryDate   String       // YYYY-MM-DD
  status         String       @default("SCHEDULED") // SCHEDULED | PAUSED | CANCELLED
  orderNote      String       @default("")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([deliveryDate, status])
  @@index([subscriptionId, deliveryDate])
}

model OneTimeOrder {
  id                String   @id @default(cuid())
  orderId           String   @unique
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  flowerSummary     String   @db.Text
  itemsJson         String   @db.Text
  totalGrams        Int
  amountPaid        Int
  deliveryDate      String   // YYYY-MM-DD
  deliverySlot      String   @default("6:00 AM – 8:00 AM")
  addressSnapshot   String   @db.Text
  deliveryNote      String   @db.Text
  status            String   @default("CONFIRMED")
  razorpayOrderId   String?  @unique
  razorpayPaymentId String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([deliveryDate, status])
  @@index([customerId, deliveryDate])
}

model StoreConfig {
  configKey   String   @id
  jsonPayload String   @db.LongText
  updatedAt   DateTime @updatedAt
}